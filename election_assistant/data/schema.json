{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Election Data",
  "description": "Schema for country-specific election process data files.",
  "type": "object",
  "required": ["country", "election_type", "steps", "timeline", "roles", "key_terms", "quiz"],
  "properties": {
    "country": {
      "type": "string",
      "minLength": 1
    },
    "election_type": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "duration", "responsible_party", "key_terms", "did_you_know"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "description_beginner": { "type": "string" },
          "duration": { "type": "string", "minLength": 1 },
          "responsible_party": { "type": "string", "minLength": 1 },
          "key_terms": {
            "type": "array",
            "items": { "type": "string" }
          },
          "did_you_know": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "object",
      "required": ["phases"],
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "start_offset_days", "end_offset_days", "color", "description"],
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "name": { "type": "string", "minLength": 1 },
              "start_offset_days": { "type": "integer" },
              "end_offset_days": { "type": "integer" },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "description": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "abbreviation", "description", "powers"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "abbreviation": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "powers": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "key_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["term", "full_form", "definition"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "full_form": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 },
          "introduced": { "type": "integer" }
        },
        "additionalProperties": false
      }
    },
    "quiz": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "options", "correct_index", "explanation"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "question": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          },
          "correct_index": { "type": "integer", "minimum": 0 },
          "explanation": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
